# Copy to .env.local and fill in the values.

# Postgres from `docker compose up -d`
DATABASE_URL=postgres://teamslot:teamslot@localhost:5432/teamslot
# Optional, production only: direct (non-pooled) URL used by `pnpm db:migrate`.
# DATABASE_URL_UNPOOLED=

# Random string, at least 32 chars: `openssl rand -base64 32`
BETTER_AUTH_SECRET=
# Public URL of the app (dev server runs on port 3000)
BETTER_AUTH_URL=http://localhost:3000

# GitHub OAuth App: https://github.com/settings/developers
# Homepage URL:               http://localhost:3000
# Authorization callback URL: http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
